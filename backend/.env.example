APP_NAME=ShopSense
SEED_DEMO=true
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopsense
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Any OpenAI-compatible endpoint. For Ollama: LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=llama3.1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256
